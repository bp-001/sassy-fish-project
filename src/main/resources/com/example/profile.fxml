<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="480.0" prefWidth="780.0" spacing="18.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.ProfileController">
   <padding>
      <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
   </padding>
   <children>
      <VBox prefWidth="360.0" spacing="10.0" style="-fx-background-color: #fff8f8; -fx-background-radius: 8; -fx-padding: 12;">
         <children>
            <ImageView fx:id="profileImageView" fitHeight="130.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../default%20pfp.jpg" />
               </image>
            </ImageView>
            <ImageView fx:id="editIconView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" visible="false" />

            <Label text="Username" style="-fx-font-weight: bold;" />
            <TextField fx:id="usernameField" />

            <Label text="Bio" style="-fx-font-weight: bold;" />
            <TextField fx:id="bioField" />

            <Label text="Location" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="locationComboBox" prefWidth="250.0" />

            <Label text="Favourite Posts" style="-fx-font-weight: bold;" />
            <HBox spacing="8.0">
               <children>
                  <ImageView fx:id="favourite1" fitHeight="68.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                  <ImageView fx:id="favourite2" fitHeight="68.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                  <ImageView fx:id="favourite3" fitHeight="68.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </HBox>

            <Label fx:id="errorLabel" textFill="RED" />

            <HBox spacing="8.0">
               <children>
                  <Button onAction="#handleBackToFeed" text="Back" />
                  <Button fx:id="editButton" onAction="#handleEditProfile" text="Edit" />
                  <Button fx:id="saveButton" onAction="#handleSaveProfile" text="Save" />
                  <Button fx:id="cancelButton" onAction="#handleCancelEdit" text="Cancel" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox prefWidth="360.0" spacing="8.0" style="-fx-background-color: #f9fbff; -fx-background-radius: 8; -fx-padding: 12;">
         <children>
            <Label text="User Posts" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="postsCountLabel" text="Posts: 0" />
            <ListView fx:id="postsListView" prefHeight="390.0" prefWidth="330.0" />
         </children>
      </VBox>
   </children>
</HBox>
